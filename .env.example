# قبل از اجرای پروژه این فایل رو کپی کن به .env (یا .env.development / .env.production)
# و مقدارهای واقعی رو جایگزین کن. .env.* توی .gitignore هست و نباید کامیت بشه.

# آدرس بک‌اند (بدون اسلش آخر). در پروداکشن نبودش باعث fail شدن build می‌شه
# (نگاه کن به src/config/env.ts).
VITE_API_URL=http://localhost:5000

# آدرس عمومی فرانت (برای canonical url / sitemap / og:url). اختیاری —
# نبودش فقط یه fallback نمایشی رو فعال می‌کنه، build رو fail نمی‌کنه.
VITE_SITE_URL=https://your-domain.example
